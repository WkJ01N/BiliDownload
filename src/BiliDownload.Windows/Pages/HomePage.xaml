<Page x:Class="BiliDownload_Windows.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="24,20" Spacing="20">
    <TextBlock Text="链接解析" AutomationProperties.AutomationId="HomePageTitle" Style="{StaticResource TitleTextBlockStyle}"/>
    <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="0" Padding="0" BackgroundSizing="InnerBorderEdge">
      <StackPanel Spacing="14">
        <TextBox x:Name="LinkInput" Header="视频链接" PlaceholderText="粘贴 B 站链接或 BV 号，多条链接可换行" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180"/>
        <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ParseButton" Content="解析链接" Style="{StaticResource AccentButtonStyle}" Click="Parse_Click"/><Button Content="粘贴" Click="Paste_Click"/><ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False"/></StackPanel>
      </StackPanel>
    </Border>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"><InfoBar.Content><StackPanel Spacing="8"><Button x:Name="LoginButton" Content="登录 B 站" Visibility="Collapsed" Click="Login_Click"/><Button x:Name="RetryButton" Content="重新解析" Visibility="Collapsed" Click="Parse_Click"/><Button x:Name="ComponentButton" Content="安装 / 配置 FFmpeg" Visibility="Collapsed" Click="Component_Click"/></StackPanel></InfoBar.Content></InfoBar>
    <TextBlock x:Name="ResultTitle" Visibility="Collapsed" Text="" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <StackPanel x:Name="ResultActions" Visibility="Collapsed" Spacing="12"><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="全选" Click="SelectAll_Click"/><Button Content="取消全选" Click="SelectNone_Click"/></StackPanel><ComboBox x:Name="QualityBox" Header="画质上限" MinWidth="170" MaxWidth="280" HorizontalAlignment="Left" DisplayMemberPath="DisplayLabel" SelectionChanged="Estimate_Changed" SelectedValuePath="Quality"/><Button x:Name="DownloadButton" Content="下载选中内容" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Download_Click"/></StackPanel>
    <TextBlock x:Name="SizeSummary" Visibility="Collapsed" Text="" Foreground="{ThemeResource RadixSecondaryTextBrush}" TextWrapping="Wrap"/>
    <ListView SelectionChanged="Estimate_Changed" x:Name="Results" Visibility="Collapsed" SelectionMode="Multiple" MaxHeight="1100">
      <ListView.ItemTemplate><DataTemplate>
        <Grid Padding="4,10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Cover}" Width="120" Height="74" Stretch="UniformToFill"/>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PartTitle}" Foreground="{ThemeResource RadixSecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Foreground="{ThemeResource RadixSecondaryTextBrush}"/><TextBlock Text="{Binding SizeText}" TextWrapping="Wrap" Foreground="{ThemeResource RadixSecondaryTextBrush}"/><Button Content="修改文件名" AutomationProperties.AutomationId="{Binding Id}" Tag="{Binding Id}" Click="Rename_Click"/></StackPanel>
        </Grid>
      </DataTemplate></ListView.ItemTemplate>
    </ListView>
  </StackPanel></ScrollViewer>
</Page>
