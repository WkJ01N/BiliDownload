<Page x:Class="BiliDownload_Windows.Pages.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:BiliDownload_Windows.ViewModels">
  <Grid Padding="24,18,24,20" RowSpacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="PageTitle" Text="下载队列" Style="{StaticResource SaltPageTitleStyle}"/>
      <StackPanel x:Name="StatsStrip" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border x:Name="ActiveBadge" Style="{StaticResource SaltPillBadgeStyle}">
          <TextBlock x:Name="ActiveCountText" Text="进行中 0" FontSize="12" Foreground="{ThemeResource RadixSecondaryTextBrush}"/>
        </Border>
        <Border x:Name="QueueOrCompletedBadge" Style="{StaticResource SaltPillBadgeStyle}">
          <TextBlock x:Name="CompletedCountText" Text="队列 0" FontSize="12" Foreground="{ThemeResource RadixSecondaryTextBrush}"/>
        </Border>
        <Button x:Name="BatchSelectButton" Content="批量选择" Style="{StaticResource SaltCompactButtonStyle}"
                Visibility="Collapsed" Click="BatchSelect_Click"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="NoticeHost" Grid.Row="1" Visibility="Collapsed" CornerRadius="12">
      <InfoBar x:Name="Notice" IsOpen="False" CornerRadius="12"/>
      <Border x:Name="NoticeProgress" Visibility="Collapsed" CornerRadius="12" IsHitTestVisible="False"/>
    </Grid>

    <Border x:Name="BatchBar" Grid.Row="2" Style="{StaticResource SaltSubCardStyle}" Visibility="Collapsed" Padding="14,10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="SelectedCountText" Text="已选 0 项" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="全选" Style="{StaticResource SaltCompactButtonStyle}" Click="SelectAll_Click"/>
          <Button Content="取消全选" Style="{StaticResource SaltCompactButtonStyle}" Click="SelectNone_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="BatchCopyButton" Content="复制文件" Style="{StaticResource SaltCompactButtonStyle}" Click="BatchCopy_Click"/>
          <Button x:Name="BatchRemoveButton" Content="批量删除" Style="{StaticResource SaltCompactButtonStyle}" Click="BatchRemove_Click"/>
          <Button Content="完成" Style="{StaticResource SaltPillAccentButtonStyle}" Padding="14,5" FontSize="12" Click="BatchExit_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Empty State Card -->
    <Border x:Name="Empty" Grid.Row="3" Style="{StaticResource SaltCardStyle}" VerticalAlignment="Top" Margin="0,12,0,0">
      <StackPanel Spacing="12" HorizontalAlignment="Center" Padding="12,24">
        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SaltAccentSoftBackgroundBrush}" HorizontalAlignment="Center">
          <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="{ThemeResource SaltAccentSoftForegroundBrush}"/>
        </Border>
        <TextBlock x:Name="EmptyTitle" Text="暂无下载任务" Style="{StaticResource SaltCardTitleStyle}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptySubtitle" Text="未完成的下载任务会显示在这里，完成后自动归入「已完成」" Style="{StaticResource SaltCaptionStyle}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <Button Content="去解析链接" Style="{StaticResource SaltTonalButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" Click="GoHome_Click"/>
      </StackPanel>
    </Border>

    <ListView x:Name="Tasks" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tasks_ItemClick" HorizontalContentAlignment="Stretch">
      <ListView.ItemContainerTransitions>
        <TransitionCollection>
          <AddDeleteThemeTransition/>
          <ReorderThemeTransition/>
        </TransitionCollection>
      </ListView.ItemContainerTransitions>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:DownloadTaskViewModel">
          <Border Style="{StaticResource SaltCardStyle}" Padding="{x:Bind CardPadding, Mode=OneWay}">
            <StackPanel Spacing="{x:Bind CardSpacing, Mode=OneWay}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          Visibility="{x:Bind SelectionCheckboxVisibility, Mode=OneWay}"
                          MinWidth="0" Padding="0" VerticalAlignment="Center"/>

                <Border Grid.Column="1" Width="{x:Bind CoverWidth, Mode=OneWay}" Height="{x:Bind CoverHeight, Mode=OneWay}"
                        CornerRadius="9"
                        Background="{ThemeResource SaltSubCardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                  <Grid>
                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{ThemeResource RadixSecondaryTextBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SaltAccentPillBadgeStyle}" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind PlatformLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{ThemeResource SaltAccentSoftForegroundBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Border CornerRadius="8" Padding="7,1" Background="{x:Bind StateBadgeBackground, Mode=OneWay}">
                        <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{x:Bind StateBadgeForeground, Mode=OneWay}"/>
                      </Border>
                      <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{ThemeResource RadixSecondaryTextBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                             MaxLines="{x:Bind TitleMaxLines, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>

                  <TextBlock Text="{x:Bind PartTitle, Mode=OneWay}" Visibility="{x:Bind PartTitleVisibility, Mode=OneWay}"
                             Style="{StaticResource SaltCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Visibility="{x:Bind FileNameVisibility, Mode=OneWay}"
                             Style="{StaticResource SaltCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>

              <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="5" CornerRadius="3"
                           Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"/>
              <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="12"
                         Foreground="{x:Bind MessageForeground, Mode=OneWay}"
                         Visibility="{x:Bind MessageVisibility, Mode=OneWay}" TextWrapping="Wrap"/>

              <Border Style="{StaticResource SaltInsetDividerStyle}" Margin="0" Visibility="{x:Bind DividerVisibility, Mode=OneWay}"/>

              <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                          HorizontalAlignment="Stretch" Background="Transparent">
                <AppBarButton Label="登录 B 站" Tag="{x:Bind}" Visibility="{x:Bind LoginVisibility, Mode=OneWay}" Click="Login_Click" Icon="Contact"/>
                <AppBarButton Label="音频组件" Tag="{x:Bind}" Visibility="{x:Bind AudioComponentVisibility, Mode=OneWay}" Click="AudioSettings_Click" Icon="Setting"/>
                <AppBarButton Label="{x:Bind ReparseLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind TrackChangedVisibility, Mode=OneWay}" Click="Reparse_Click" Icon="Refresh"/>
                <AppBarButton Label="{x:Bind EngineSettingsLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind YoutubeVisibility, Mode=OneWay}" Click="YoutubeSettings_Click" Icon="Setting"/>
                <AppBarButton Label="暂停" Tag="{x:Bind}" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" Click="Pause_Click" Icon="Pause"/>
                <AppBarButton Label="继续 / 重试" Tag="{x:Bind}" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" Click="Resume_Click" Icon="Refresh"/>
                <AppBarButton Label="取消" Tag="{x:Bind}" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" Click="Cancel_Click" Icon="Cancel"/>
                <AppBarButton Label="复制文件" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Copy_Click" Icon="Copy"/>
                <AppBarButton Label="文件夹" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Folder_Click" Icon="Folder"/>
                <AppBarButton Label="{x:Bind OpenLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Open_Click" Icon="Play"/>
                <AppBarButton Label="移除记录" Tag="{x:Bind}" Click="Remove_Click" Icon="Delete"/>
              </CommandBar>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
