<Page x:Class="BiliDownload_Windows.Pages.QueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:BiliDownload_Windows.ViewModels">
 <Grid Padding="24,20" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock x:Name="PageTitle" Text="下载队列" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
  <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False"/>
  <Grid Grid.Row="2"><TextBlock x:Name="Empty" Text="暂无下载任务" Foreground="{ThemeResource RadixSecondaryTextBrush}" Margin="0,20"/>
  <ListView x:Name="Tasks" SelectionMode="None" HorizontalContentAlignment="Stretch">
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate x:DataType="vm:DownloadTaskViewModel">
    <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,0.5" CornerRadius="0" Padding="0,16" Margin="0,0,0,12">
     <StackPanel Spacing="10"><TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PartTitle}" Foreground="{ThemeResource RadixSecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Foreground="{ThemeResource RadixSecondaryTextBrush}"/><ProgressBar Value="{Binding Progress}" Maximum="100"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" HorizontalAlignment="Stretch" Background="Transparent">
       <AppBarButton Label="登录 B 站" Tag="{x:Bind}" Visibility="{x:Bind LoginVisibility, Mode=OneWay}" Click="Login_Click" Icon="Contact"/>
       <AppBarButton Label="暂停" Tag="{x:Bind}" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" Click="Pause_Click" Icon="Pause"/>
       <AppBarButton Label="继续 / 重试" Tag="{x:Bind}" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" Click="Resume_Click" Icon="Refresh"/>
       <AppBarButton Label="取消" Tag="{x:Bind}" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" Click="Cancel_Click" Icon="Cancel"/>
       <AppBarButton Label="复制文件" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Copy_Click" Icon="Copy"/>
       <AppBarButton Label="文件夹" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Folder_Click" Icon="Folder"/>
       <AppBarButton Label="播放" Tag="{x:Bind}" Visibility="{x:Bind FileVisibility, Mode=OneWay}" Click="Open_Click" Icon="Play"/>
       <AppBarButton Label="移除记录" Tag="{x:Bind}" Click="Remove_Click" Icon="Delete"/>
      </CommandBar>
     </StackPanel>
    </Border>
   </DataTemplate></ListView.ItemTemplate>
  </ListView></Grid>
 </Grid>
</Page>
