<Window x:Class="BiliDownload_Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BiliDownload">
  <Grid x:Name="Root" Background="{ThemeResource SaltCanvasBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleRegion" Padding="18,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/AppIcon.png" Width="22" Height="22" Stretch="UniformToFill"/>
        <TextBlock Text="BiliDownload" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource SaltAccentPillBadgeStyle}" Padding="7,2" VerticalAlignment="Center">
          <TextBlock Text="0.4.3" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SaltAccentSoftForegroundBrush}"/>
        </Border>
      </StackPanel>
    </Grid>

    <InfoBar x:Name="ClipboardNotice" Grid.Row="1" IsOpen="False" Severity="Informational"
             Title="发现可下载链接" Message="" Margin="16,4,16,6" CornerRadius="12">
      <InfoBar.ActionButton>
        <Button x:Name="ViewClipboardButton" Content="查看链接" Style="{StaticResource SaltCompactButtonStyle}" Click="ViewClipboard_Click"/>
      </InfoBar.ActionButton>
    </InfoBar>

    <InfoBar x:Name="BehaviorNotice" Grid.Row="2" IsOpen="False" Severity="Informational"
             Title="后台链接提示已启用" Message="可在设置中关闭。" Margin="16,0,16,6" CornerRadius="12">
      <InfoBar.ActionButton>
        <Button Content="关闭监听" Style="{StaticResource SaltCompactButtonStyle}" Click="DisableClipboard_Click"/>
      </InfoBar.ActionButton>
    </InfoBar>

    <NavigationView x:Name="Navigation" Grid.Row="3" SelectionChanged="Navigation_SelectionChanged"
                    IsBackButtonVisible="Collapsed" OpenPaneLength="224" CompactPaneLength="56"
                    PaneDisplayMode="Auto" IsSettingsVisible="True" Background="Transparent">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="链接解析" Tag="home" IsSelected="True">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71B;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="下载队列" Tag="queue">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE896;"/>
          </NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="QueueBadge" Visibility="Collapsed"/>
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem Content="已完成" Tag="completed">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE73E;"/>
          </NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="CompletedBadge" Visibility="Collapsed" Style="{ThemeResource InformationalValueInfoBadgeStyle}"/>
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ContentFrame"/>
    </NavigationView>
  </Grid>
</Window>
